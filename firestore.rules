rules_version = '2';

// Security rules for "Jeszcze Mleko".
// Paste into the Firebase console: Firestore Database -> Rules -> Publish.
//
// This is the second line of defence. The first one is App Check (reCAPTCHA v3),
// which filters out traffic that does not come from the app. These rules cover
// the rest: who has access to which list, and what shape the stored documents
// are allowed to have.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /lists/{listId} {

      function isMember() {
        return signedIn() && resource.data.members[request.auth.uid] == true;
      }

      // Joining a list by code: a new member may add ONLY themselves to members
      // and may not touch any other field.
      function joiningSelf() {
        return signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.diff(resource.data.members)
               .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.members[request.auth.uid] == true
          && request.resource.data.members.keys().size() <= 10;
      }

      // 'name' is optional. A list without one shows a title translated on each
      // device, instead of freezing the creator's language for everybody.
      // A member may edit the list, but the members map is not theirs to rewrite:
      // they may only add or remove their own key. Without this, any member could
      // kick everybody else out or quietly add a stranger's uid — measured, not
      // theorised: both went through before this existed.
      function membersOnlySelf() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['members'])
          || request.resource.data.members.diff(resource.data.members)
               .affectedKeys().hasOnly([request.auth.uid]);
      }

      function validList() {
        return request.resource.data.keys().hasOnly(['name', 'code', 'members', 'createdAt'])
          && (!('name' in request.resource.data) || (
               request.resource.data.name is string
               && request.resource.data.name.size() > 0
               && request.resource.data.name.size() <= 60))
          && request.resource.data.code is string
          && request.resource.data.code.size() == 6
          && request.resource.data.members.keys().size() <= 10;
      }

      // The last member may take the list down with them. With anybody else
      // still on it, deletion stays impossible — leaving only removes your own
      // key from members, which the update rule above already permits.
      function lastMember() {
        return isMember() && resource.data.members.keys().hasOnly([request.auth.uid]);
      }

      allow read: if isMember();
      allow create: if signedIn()
        && validList()
        && request.resource.data.members.keys().hasOnly([request.auth.uid]);
      allow update: if (isMember() && validList() && membersOnlySelf()) || joiningSelf();
      allow delete: if lastMember();

      match /items/{itemId} {

        function memberOfList() {
          return signedIn()
            && get(/databases/$(database)/documents/lists/$(listId))
                 .data.members[request.auth.uid] == true;
        }

        // amount is free text — "6", "50 dag", "1,5 l", "pół kilo". A number on
        // its own cannot say whether 50 means slices, grams or decagrams, and
        // nothing here ever computes with the value: it is a note for whoever is
        // holding the basket. It is absent whenever the answer is simply one.
        function validItem() {
          return request.resource.data.keys().hasOnly(['name', 'dept', 'done', 'createdAt', 'amount'])
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 80
            && request.resource.data.dept is string
            && request.resource.data.dept.size() <= 30
            && request.resource.data.done is bool
            // Checked like the timestamps on feedback and unmatched. On an update
            // request.resource.data is the merged document, so the value carried
            // over from the stored one satisfies this without being resent.
            && request.resource.data.createdAt is timestamp
            && (!('amount' in request.resource.data) || (
                 request.resource.data.amount is string
                 && request.resource.data.amount.size() > 0
                 && request.resource.data.amount.size() <= 12));
        }

        allow read, delete: if memberOfList();
        allow create, update: if memberOfList() && validItem();
      }
    }

    // Messages sent from the settings panel. Same shape as `unmatched`:
    // create-only from the client, so one user cannot read, edit or delete
    // another's, and no uid or list id is stored. Read it in the Firebase
    // console — nothing notifies you.
    match /feedback/{id} {
      allow read, update, delete: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['message', 'locale', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.locale is string
        && request.resource.data.locale.size() <= 5
        && request.resource.data.createdAt is timestamp;
    }

    // Names that matched no department, so the dictionary can be improved.
    //
    // Write-only from the client, deliberately: item names can be personal, and
    // nobody using the app should be able to read back what anybody else typed.
    // The owner reads this in the Firebase console. Only the name and a counter
    // are stored — no uid, no list id, nothing tying a name to a person.
    match /unmatched/{key} {
      allow read: if false;
      allow delete: if false;

      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'count', 'lastSeen'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.count is int
        && request.resource.data.count > 0
        && request.resource.data.lastSeen is timestamp;
    }

    // Reverse index code -> listId. Someone joining has to turn the code into a
    // listId before they are allowed to read the list itself, which is why this
    // is a separate collection.
    match /codes/{code} {
      // get, not list — asking about one known code is fine, but browsing the
      // whole collection (and harvesting codes) is not.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['listId'])
        && request.resource.data.listId is string
        && request.resource.data.listId.size() <= 40
        && code.size() == 6;

      // Once a code points at a list it never changes meaning — otherwise
      // someone could redirect another person's invite code to their own list.
      allow update: if false;

      // Deletable by the list's last member, as part of cleaning up on the way
      // out. The second branch covers a code left pointing at a list that is
      // already gone: a dangling pointer nobody can use and anybody may sweep up.
      allow delete: if signedIn() && (
        !exists(/databases/$(database)/documents/lists/$(resource.data.listId))
        || get(/databases/$(database)/documents/lists/$(resource.data.listId))
             .data.members.keys().hasOnly([request.auth.uid])
      );
    }
  }
}
